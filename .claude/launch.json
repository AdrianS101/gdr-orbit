{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "orbit",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--disable-warning=ExperimentalWarning",
        "server/src/index.ts"
      ],
      "port": 4310
    },
    {
      "name": "orbit-test",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--disable-warning=ExperimentalWarning",
        "server/src/index.ts"
      ],
      "env": {
        "ORBIT_DATA_DIR": "data-test"
      },
      "port": 4310
    }
  ]
}